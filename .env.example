# Copy to .env.local and fill in. .env.local is gitignored.
#
# Global credentials (App Store Connect API key, issuer, key path, team ID)
# come from ~/.config/opencode/env/testflight-release.env — do NOT put them
# in this project file. This file holds project-specific values only.

APP_BUNDLE_ID=com.example.myapp
XCODE_WORKSPACE=xtool/myapp.xcworkspace
XCODE_SCHEME=myapp-App

# Required by the `submit` step (App Review / external TestFlight).
# Set the description here; contact info comes from the global env file.
BETA_APP_DESCRIPTION="A short description of your app shown to external testers."
